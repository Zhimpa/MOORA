# Supabase (Project Settings > API)
#
# En local: copia este archivo a .env.local y completa los valores.
# En Vercel: Project Settings > Environment Variables, y despues REDEPLOY
# (las NEXT_PUBLIC_* se incrustan al construir; un deploy viejo no las ve).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta: solo servidor. Nunca en codigo del cliente ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
